{
  "name": "taltech-moodle-kex",
  "version": "0.1.0",
  "private": true,
  "description": "A fast, keyboard-first redesign of moodle.taltech.ee (Firefox extension).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "build:local": "node scripts/sync-local.mjs",
    "demo": "node scripts/local-demo.mjs",
    "test:local": "playwright test -c playwright.local.config.ts",
    "verify:release": "node scripts/release-gate.mjs",
    "verify:build": "node scripts/provenance.mjs",
    "test:live": "node scripts/live-smoke.mjs",
    "build:probe": "node scripts/build.mjs --dev --mv3-probe",
    "watch": "node scripts/build.mjs --dev --watch",
    "typecheck": "tsc --noEmit",
    "lint": "npm run lint:eslint && npm run typecheck && npm run lint:webext",
    "lint:eslint": "eslint src test scripts",
    "lint:css": "node scripts/check-css.mjs",
    "lint:webext": "npm run build && web-ext lint -s dist/firefox --warnings-as-errors=false",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:ff": "npm run build:dev && node test/e2e-firefox/smoke.mjs --only quick",
    "test:ff:full": "npm run build:dev && node test/e2e-firefox/smoke.mjs",
    "shots": "node scripts/test-visual.mjs --all",
    "pack": "node scripts/pack.mjs prod",
    "pack:dev": "node scripts/pack.mjs dev",
    "sign": "web-ext sign --channel=unlisted -s dist/firefox --api-key=$WEB_EXT_API_KEY --api-secret=$WEB_EXT_API_SECRET"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/inter-tight": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@preact/signals": "^2.11.3",
    "lucide-preact": "^1.57.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.56.1",
    "@types/firefox-webext-browser": "^143.0.1",
    "@types/node": "^22.0.0",
    "@types/selenium-webdriver": "^4.1.0",
    "esbuild": "~0.28.2",
    "eslint": "^9.39.5",
    "happy-dom": "^21.0.1",
    "playwright": "1.56.1",
    "postcss": "^8.5.30",
    "selenium-webdriver": "^4.51.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^3.2.7",
    "web-ext": "10.8.0"
  },
  "overrides": {
    "playwright-core": "1.56.1"
  }
}
